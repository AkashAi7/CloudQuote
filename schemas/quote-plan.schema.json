{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AkashAi7/CloudQuote/schemas/quote-plan.schema.json",
  "title": "CloudQuote Quote Plan",
  "type": "object",
  "required": ["schemaVersion", "sourceProvider", "targetProvider", "lines"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "sourceProvider": {"enum": ["aws", "azure", "gcp", "github", "external"]},
    "targetProvider": {"enum": ["aws", "azure", "gcp", "github", "external"]},
    "opportunityReview": {"$ref": "opportunity-review.schema.json"},
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "assumptions", "validations"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"$ref": "#/$defs/serviceLine"},
          "target": {"$ref": "#/$defs/serviceLine"},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "validations": {"type": "array", "items": {"type": "string"}},
          "pricingEvidence": {
            "type": "array",
            "items": {"$ref": "#/$defs/pricingEvidence"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["opportunityReview"],
        "properties": {"opportunityReview": {"properties": {"mode": {"const": "quick-triage"}}}}
      },
      "then": {},
      "else": {"properties": {"lines": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "serviceLine": {
      "type": "object",
      "required": ["provider", "service", "sku"],
      "properties": {
        "provider": {"enum": ["aws", "azure", "gcp", "github", "external"]},
        "service": {"type": "string"},
        "sku": {"type": "string"},
        "quantity": {"type": "number"},
        "unit": {"type": "string"},
        "capacity": {"type": "string"},
        "monthlyCost": {"type": "number"}
      },
      "additionalProperties": false
    },
    "pricingEvidence": {
      "type": "object",
      "required": ["source", "status", "provider", "service", "sku", "region", "currency", "priceType", "meterName", "unitOfMeasure", "unitPrice", "retrievedAt", "evidenceUrl"],
      "properties": {
        "source": {"enum": ["mcp-web", "search-api", "official-page", "manual"]},
        "status": {"const": "approved"},
        "provider": {"enum": ["aws", "azure", "gcp", "github", "external"]},
        "service": {"type": "string", "minLength": 1},
        "sku": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "minLength": 1},
        "priceType": {"enum": ["Consumption", "Reservation"]},
        "reservationTerm": {"enum": ["1 Year", "3 Years"]},
        "meterName": {"type": "string", "minLength": 1},
        "unitOfMeasure": {"type": "string", "minLength": 1},
        "unitPrice": {"type": "number", "minimum": 0},
        "retrievedAt": {"type": "string", "format": "date-time"},
        "evidenceUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}